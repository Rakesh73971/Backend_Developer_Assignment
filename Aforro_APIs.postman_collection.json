						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"store_id\": 97,\n  \"items\": [\n    {\n      \"product_id\": 3980,\n      \"quantity_requested\": 1\n    },\n    {\n      \"product_id\": 3719,\n      \"quantity_requested\": 1\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"orders",
								""
							]
						},
						"description": "Place an order at Store 97 for products that are in stock. This checks stock level, locks the database, deducts quantities, and returns a CONFIRMED order response. (Note: Make sure product_id exists and has quantity > 0 in your database)."
					},
					"response": []
				},
				{
					"name": "POST Create Order (Rejected - Out of Stock)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"store_id\": 97,\n  \"items\": [\n    {\n      \"product_id\": 3511,\n      \"quantity_requested\": 9999\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"orders",
								""
							]
						},
						"description": "Place an order requesting more stock than available. This will create an Order object with status REJECTED, deduct 0 quantities, and return a list of stock validation error messages."
